# Gradle
.gradle/
build/
**/build/
.kotlin/
# Where AGP drops the finished release artifact, the APK and its R8 mapping.txt. 60 MB of
# build output that is rebuilt from a tag, and an APK is never committed.
app/release/

# Android Studio / IntelliJ — the SDK path is per machine and absolute
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Signing — never in the repository (see docs/DEPLOYMENT.md). The release key itself lives
# OUTSIDE this checkout, in a sibling folder, precisely so that no ignore rule has to be
# right: the file has no extension, so the patterns below would not have caught it anyway.
# An ignore rule is a convention (`git add -f` overrides it), not a lock.
*.keystore
*.jks
keystore/
release.properties
keystore.properties

# Play service account and any Google secret file
*-service-account*.json
service-account*.json

# Node (git-cliff, Firebase rules tests)
node_modules/

# Firebase emulator
firebase/.firebase/
firebase/*-debug.log
firebase/ui-debug.log
firebase/database-debug.log

# Apps Script deployment state (clasp) — the script id is fine, the login is not
push/.clasprc.json

# Editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Logs
*.log

# Claude Code local overrides (machine-specific; the shared settings.json is committed)
.claude/settings.local.json
