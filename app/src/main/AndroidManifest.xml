<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dictation (PLAN.md Phase 7). Asked for at the first tap on the mic, never at start;
         the audio goes to the system recognizer only and is never stored by the app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notifications (PLAN.md Phase 9). Asked for when the user turns them on in Ustawienia,
         never at start; nothing at all is posted while that switch is off. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Installing an update the app downloaded from its own GitHub Releases (PLAN.md Phase 10,
         task 3). Never a runtime dialog: on every version this app supports the user allows it
         on a Settings screen, or not at all (STATE.md decision 110). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A phone without a microphone still installs the app: it simply has no mic button. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- From Android 11 an app sees another only if it says so. Without this the recognizer
         is reported as missing and the mic button would hide itself on every phone. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".BuyMyWayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuyMyWay">

        <!-- singleTop: an invite link opened while the app runs reaches onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links (PLAN.md Phase 5; STATE.md decisions 35 and 63). The host's
                 /.well-known/assetlinks.json lets Android open them here directly. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="eatmyway.gorny.dev" />
                <data android:pathPrefix="/bmw/i/" />
            </intent-filter>
            <!-- The fallback the host's page opens when the App Link is not verified. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="buymyway" android:host="i" />
            </intent-filter>
            <!-- A shopping list shared out of Eat My Way, or any other text (PLAN.md Phase 8,
                 task 2). Text is all this app accepts: no file, no image, no stream. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- A change on a shared list, sent by the Apps Script (PLAN.md Phase 9, task 1). Data
             only: a list id, three numbers and a name, never what changed. `exported` is
             required by FCM, which is the only sender the framework lets reach it. -->
        <service
            android:name=".data.push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The app's own delete intent, so a swiped notification stops counting. Not exported. -->
        <receiver
            android:name=".data.push.NotificationDismissed"
            android:exported="false" />

        <!-- Firebase Messaging's defaults, so a notification looks the same however it is
             posted; the app builds its own, and these only cover the framework's fallback. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="changes" />

        <!-- The camera app writes the photo it takes through this (PLAN.md Phase 6, task 1).
             TakePicture and the Photo Picker need no permission, and none is declared: no
             camera, no storage, no media (STATE.md decision 71). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!-- The downloaded release APK, handed to the package installer (PLAN.md Phase 10,
             task 3). Its own class and authority: two providers of the same class in one
             package collide, and this way the camera's provider keeps covering exactly one
             directory and this one exactly one other. -->
        <provider
            android:name=".data.update.UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
